#!/bin/bash
#
# git hook dispatcher (由 `inf hooks install` 安裝, 來源 platform/inf svc/githooks/template)。
#
# git 每個 hook 名稱只跑一個檔, 所以 .githooks/<hook> 只負責分派: 依檔名順序執行
# .githooks/<hook>.d/*.sh, 每支都拿到同一份 stdin 與同樣的 args。哪些腳本在場
# 由 `inf hooks install` 決定, `inf hooks list` 看全部可選項。
#
# 契約: stdin 只能讀一次, 這裡先整份收下再分給每支腳本。GIT_PUSH_PID 是
# 呼叫本 hook 的 git process ($PPID), 子腳本的 $PPID 會變成本 dispatcher。
# 任何子腳本失敗都不擋下 git: 本檔永遠 exit 0。

set -uo pipefail

hook="$(basename "$0")"
input="$(cat)"
export GIT_PUSH_PID="$PPID"

for script in "$0.d"/*.sh; do
	[[ -x "$script" ]] || continue
	printf '%s\n' "$input" | "$script" "$@" || echo "${hook}: $(basename "$script") 失敗, 略過" >&2
done

exit 0
